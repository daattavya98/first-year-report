@article{heHolographicEntropyRelations2019,
  title         = {Holographic {{Entropy Relations Repackaged}}},
  author        = {He, Temple and Headrick, Matthew and Hubeny, Veronika E.},
  year          = {2019},
  month         = oct,
  journal       = {Journal of High Energy Physics},
  volume        = {2019},
